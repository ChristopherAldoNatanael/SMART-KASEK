# =====================================================
# SMART KASEK — Environment Variables
# =====================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =====================================================

# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Canonical public URL — WAJIB di production bila pakai custom domain.
# Contoh: https://smartkasek.sch.id (tanpa trailing slash).
# Dipakai auth callback agar tidak mental ke *.vercel.app.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only: Never expose this to the client
# Get this from Supabase > Settings > API > service_role key
# WARNING: This key bypasses RLS. Use only in server-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cron tutup sesi QR basi (00:05 WIB) — server-only, TANPA prefix NEXT_PUBLIC_
# Buat string acak panjang (mis. openssl rand -hex 32), isi SAMA di:
# 1. Vercel Dashboard > Settings > Environment Variables > CRON_SECRET, dan
# 2. vercel.json > crons[0].path > ?secret=...
# Endpoint: GET /api/cron/close-stale-sessions (Bearer atau ?secret=)
CRON_SECRET=isi-string-acak-panjang-di-sini

# AI (Gemini Flash via Google AI Studio) — server-only, TANPA prefix NEXT_PUBLIC_
# Dapatkan API key di https://aistudio.google.com/apikey
# Untuk production (Vercel): isi keempat variabel ini di
# Dashboard > Settings > Environment Variables.
AI_PROVIDER=custom
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=isi-api-key-anda-di-sini
