# =====================================================
# SMART KASEK — Environment Variables
# =====================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =====================================================

# Supabase Configuration
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: Never expose this to the client
# Get this from Supabase > Settings > API > service_role key
# WARNING: This key bypasses RLS. Use only in server-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Provider Configuration
# Options: mock (default, no key needed), openai, custom (any OpenAI-compatible endpoint)
AI_PROVIDER=mock
AI_API_KEY=your-api-key-here
# Model used by openai/custom providers (default: gpt-4o-mini)
AI_MODEL=gpt-4o-mini
# Required only for AI_PROVIDER=custom, e.g. http://localhost:11434/v1
AI_BASE_URL=
